<!DOCTYPE html>
<!-- saved from url=(0065)https://makarchik010.github.io/withiv-agency/frontend/index.html# -->
<html lang="ru" class="scroll-smooth"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withiv — Турагентство индивидуальных путешествий</title>
    <link rel="icon" type="image/jpeg" href="./qr-manager_files/logo.jpg">

    <meta property="og:title" content="Withiv — Турагентство">
    <meta property="og:description" content="Онлайн поиск туров по 80 туроператорам, авторские туры и полное сопровождение в поездке по всему миру.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&amp;w=1200&amp;auto=format&amp;fit=crop">

    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
    <link href="./qr-manager_files/css2" rel="stylesheet">

    <script src="./qr-manager_files/saved_resource"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand_bg: '#F7F4EF',
                        brand_dark: '#1B3B2B',
                        brand_accent: '#C59B27',
                    },
                    fontFamily: {
                        sans: ['Manrope', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --fs-h1: clamp(1.85rem, 3.6vw + 0.75rem, 3.75rem);
            --fs-h2: clamp(1.5rem, 2.2vw + 0.65rem, 2.5rem);
            --fs-h3: clamp(1.125rem, 1vw + 0.7rem, 1.5rem);
            --fs-lead: clamp(0.95rem, 0.7vw + 0.7rem, 1.25rem);
            --fs-body: clamp(0.9375rem, 0.25vw + 0.85rem, 1.0625rem);
            --fs-small: 0.8125rem;
            --fs-label: 0.6875rem;
        }

        html {
            font-size: 16px;
            scroll-padding-top: 84px;
            text-size-adjust: 100%;
            -webkit-text-size-adjust: 100%;
        }

        body {
            background-color: #F7F4EF;
            color: #1B3B2B;
            font-family: 'Manrope', sans-serif;
            font-size: var(--fs-body);
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        h1, h2, h3, h4 {
            text-wrap: balance;
            letter-spacing: -0.02em;
        }

        .type-h1 { font-size: var(--fs-h1); line-height: 1.08; font-weight: 700; }
        .type-h2 { font-size: var(--fs-h2); line-height: 1.15; font-weight: 700; }
        .type-h3 { font-size: var(--fs-h3); line-height: 1.25; font-weight: 700; }
        .type-lead { font-size: var(--fs-lead); line-height: 1.45; font-weight: 500; }
        .type-small { font-size: var(--fs-small); line-height: 1.45; }
        .type-label { font-size: var(--fs-label); line-height: 1.2; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; }
        .tabular { font-variant-numeric: tabular-nums; }

        .glass-header { background: rgba(247, 244, 239, 0.96); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .logo-light-bg { mix-blend-mode: multiply; }
        .logo-dark-bg { filter: grayscale(100%) invert(100%) contrast(200%); mix-blend-mode: screen; }

        .quiz-step { display: none; }
        .quiz-step.active { display: flex; flex-direction: column; animation: fadeIn 0.35s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #1B3B2B; border-radius: 3px; }
        input, select, textarea { font-size: 16px !important; }

        .reviews-scroll, .hide-scrollbar {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .reviews-scroll::-webkit-scrollbar, .hide-scrollbar::-webkit-scrollbar { display: none; }

        #tour-modal, #privacy-modal { transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        #modal-backdrop { transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), backdrop-filter 0.35s ease; }
        #modal-content { transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        .modal-closed #modal-content { transform: translateY(50px) scale(0.97); opacity: 0; }
        .modal-open #modal-content { transform: translateY(0) scale(1); opacity: 1; }

        .quiz-radio:checked + div {
            border-color: #1B3B2B;
            background-color: rgba(27, 59, 43, 0.05);
        }
        .quiz-radio:checked + div .radio-inner {
            background-color: #1B3B2B;
            border-color: #1B3B2B;
        }
    </style>
