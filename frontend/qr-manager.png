<body class="font-sans selection:bg-brand_dark selection:text-white flex flex-col min-h-screen">

    <!-- Header -->
    <header class="fixed top-0 w-full z-[1000] glass-header border-b border-brand_dark/10">
        <div class="max-w-7xl mx-auto px-4 md:px-8 h-16 md:h-20 flex items-center justify-between gap-4">
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#" class="flex items-center shrink-0 transition-opacity duration-300 hover:opacity-80">
                <div class="h-10 md:h-12 overflow-hidden flex items-start">
                    <img src="./qr-manager_files/logo.jpg" alt="Withiv Турагентство" class="h-[58px] md:h-[70px] w-auto max-w-none block logo-light-bg">
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-2 type-small font-medium text-brand_dark/85">
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tourvisor-search" class="px-4 py-1.5 rounded-full border border-brand_dark/15 hover:border-brand_dark hover:bg-brand_dark hover:text-white transition-all whitespace-nowrap">Подбор тура</a>
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tours" class="px-4 py-1.5 rounded-full border border-brand_dark/15 hover:border-brand_dark hover:bg-brand_dark hover:text-white transition-all whitespace-nowrap">Авторские туры</a>
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#reviews" class="px-4 py-1.5 rounded-full border border-brand_dark/15 hover:border-brand_dark hover:bg-brand_dark hover:text-white transition-all whitespace-nowrap">Отзывы</a>
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#about" class="px-4 py-1.5 rounded-full border border-brand_dark/15 hover:border-brand_dark hover:bg-brand_dark hover:text-white transition-all whitespace-nowrap">Об агентстве</a>
            </nav>

            <div class="hidden lg:flex items-center gap-4 shrink-0">
                <div class="text-right hidden xl:block">
                    <a href="tel:+79127415413" class="block type-small font-bold text-brand_dark hover:text-brand_accent transition-colors tabular">+7 (912) 741-54-13</a>
                    <span class="block text-[11px] text-brand_dark/60">Онлайн турагентство</span>
                </div>
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#quiz-section" class="bg-brand_accent text-white px-5 py-2.5 rounded-lg type-small font-bold hover:bg-brand_dark transition-colors shadow-sm whitespace-nowrap">
                    Заявка на тур
                </a>
            </div>

            <!-- Бургер виден на всех экранах до lg (включая планшеты 768-1023px) -->
            <div class="flex items-center gap-2.5 lg:hidden">
                <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#quiz-section" class="bg-brand_accent text-white px-3.5 py-2 rounded-lg type-label !tracking-wider shadow-sm">
                    Заявка
                </a>
                <button id="mobile-menu-btn" type="button" aria-label="Меню" class="p-2 text-brand_dark">
                    <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile & Tablet Menu -->
    <div id="mobile-menu" style="background-color: #F7F4EF; z-index: 999;" class="fixed inset-0 pt-24 px-6 pb-8 hidden flex-col lg:hidden overflow-y-auto">
        <nav class="flex flex-col space-y-5 text-center type-h3">
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tourvisor-search" class="mobile-link text-brand_dark hover:text-brand_accent py-1">Поиск туров</a>
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tours" class="mobile-link text-brand_dark hover:text-brand_accent py-1">Авторские туры</a>
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#quiz-section" class="mobile-link text-brand_dark hover:text-brand_accent py-1">Индивидуальный подбор</a>
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#reviews" class="mobile-link text-brand_dark hover:text-brand_accent py-1">Отзывы клиентов</a>
            <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#about" class="mobile-link text-brand_dark hover:text-brand_accent py-1">Об агентстве</a>
            <hr class="border-brand_dark/10 my-2">
            <div class="flex flex-col gap-3 w-full max-w-sm mx-auto pt-2">
                <a href="tel:+79127415413" class="type-h3 text-brand_dark tabular">+7 (912) 741-54-13</a>
                <a href="https://t.me/withivtravel13" target="_blank" rel="noopener noreferrer" class="w-full bg-brand_dark text-brand_bg px-5 py-4 rounded-lg type-small font-bold text-center">
                    Telegram-канал Withiv
                </a>
            </div>
        </nav>
    </div>

    <!-- Hero Section -->
    <section id="tourvisor-search" class="relative min-h-[100svh] md:min-h-[85vh] md:max-h-[920px] flex flex-col justify-end pt-24 pb-8 md:pb-14">
        <div class="absolute inset-0 z-0 bg-[#0d3b46]">
            <img src="./qr-manager_files/photo-1507525428034-b723cf961d3e" srcset="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&amp;w=800&amp;auto=format&amp;fit=crop 800w,
                        https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&amp;w=1400&amp;auto=format&amp;fit=crop 1400w,
                        https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&amp;w=2000&amp;auto=format&amp;fit=crop 2000w" sizes="100vw" fetchpriority="high" alt="Withiv Travel" class="w-full h-full object-cover object-center">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/15"></div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 text-white mt-auto">
            <div class="max-w-3xl mb-6 md:mb-10">
                <h1 class="type-h1 mb-3 md:mb-4 drop-shadow-md">
                    Онлайн поиск туров<br>
                    по 80 туроператорам
                </h1>
                <p class="type-lead text-white/95 drop-shadow max-w-2xl">
                    Выбирайте и бронируйте туры онлайн без забот — с полным сопровождением Withiv
                </p>
            </div>

            <!-- КОНТЕЙНЕР ДЛЯ ВИДЖЕТА TOURVISOR (пока без обманки — честный блок с 2 действиями) -->
            <div id="tourvisor-widget-container" class="w-full bg-white/95 backdrop-blur-md text-brand_dark rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.28)] p-4 md:p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <span class="type-label text-brand_accent block mb-1">Индивидуальный подбор 24/7</span>
                        <p class="type-small md:text-base font-semibold text-brand_dark">Ответьте на 5 коротких вопросов — пришлём 3–5 проверенных отелей с точным расчётом цены</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-2.5 shrink-0">
                        <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#quiz-section" class="py-3.5 px-7 bg-brand_accent hover:bg-brand_dark text-white font-bold type-small rounded-lg text-center transition-colors shadow-md whitespace-nowrap">
                            Подобрать тур
                        </a>
                        <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tours" class="py-3.5 px-6 bg-brand_bg hover:bg-brand_dark/10 text-brand_dark font-bold type-small rounded-lg text-center transition-colors whitespace-nowrap">
                            Авторские туры
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Author Tours Collection -->
    <section id="tours" class="py-14 md:py-24 max-w-7xl mx-auto px-4 md:px-8 w-full">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 md:mb-12 gap-5">
            <div>
                <span class="type-label text-brand_accent block mb-2">Эксклюзивные маршруты</span>
                <h2 class="type-h2">Авторские туры Withiv</h2>
            </div>

            <div id="filter-tabs" class="flex gap-2 overflow-x-auto pb-2 w-full md:w-auto hide-scrollbar"></div>
        </div>

        <div id="tours-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"><div class="col-span-full py-12 text-center font-medium text-brand_dark/60 type-small">В данный момент по этому направлению нет предложений в коллекции.</div></div>
    </section>

    <!-- Reviews Section -->
    <section id="reviews" class="py-14 md:py-24 bg-white border-t border-brand_dark/5 overflow-hidden w-full">
        <div class="max-w-7xl mx-auto px-4 md:px-8 mb-8 md:mb-10 flex items-end justify-between gap-4">
            <div>
                <span class="type-label text-brand_accent block mb-2">Доверие</span>
                <h2 class="type-h2">Отзывы наших туристов</h2>
            </div>
            <!-- Кнопки прокрутки для десктопа с мышкой -->
            <div class="hidden md:flex items-center gap-2 shrink-0">
                <button type="button" onclick="scrollReviews(-380)" aria-label="Предыдущие отзывы" class="w-11 h-11 rounded-full border border-brand_dark/20 text-brand_dark hover:bg-brand_dark hover:text-white flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <button type="button" onclick="scrollReviews(380)" aria-label="Следующие отзывы" class="w-11 h-11 rounded-full border border-brand_dark/20 text-brand_dark hover:bg-brand_dark hover:text-white flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </div>

        <div id="reviews-container" class="flex overflow-x-auto gap-4 md:gap-6 px-4 md:px-8 max-w-7xl mx-auto pb-6 snap-x snap-mandatory reviews-scroll"><div class="w-full text-center py-12 text-brand_dark/50 type-small">Отзывы скоро появятся...</div></div>
    </section>

    <!-- Quick View Modal -->
    <div id="tour-modal" class="fixed inset-0 z-[1050] hidden items-end md:items-center justify-center sm:p-6 modal-closed">
        <div id="modal-backdrop" class="absolute inset-0 bg-brand_dark/80 backdrop-blur-md opacity-0" onclick="closeModal()"></div>

        <!-- На мобилке скроллится вся модалка целиком, на десктопе — правая колонка -->
        <div id="modal-content" class="relative bg-brand_bg w-full md:max-w-4xl rounded-t-2xl md:rounded-xl shadow-2xl flex flex-col md:flex-row max-h-[92vh] overflow-y-auto md:overflow-hidden z-10">

            <button onclick="closeModal()" type="button" aria-label="Закрыть" class="absolute top-4 right-4 z-30 w-10 h-10 bg-black/45 hover:bg-brand_dark text-white md:bg-brand_dark/10 md:text-brand_dark md:hover:bg-brand_dark md:hover:text-white backdrop-blur-md rounded-full flex items-center justify-center transition-all duration-300 shadow-sm border border-white/20 md:border-transparent">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>

            <div class="w-full md:w-1/2 h-52 sm:h-64 md:h-auto bg-brand_dark shrink-0 relative overflow-hidden">
                <img id="modal-img" src="https://makarchik010.github.io/withiv-agency/frontend/index.html" alt="Тур" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent md:hidden"></div>
                <div class="absolute bottom-4 left-5 right-5 md:hidden">
                    <span id="modal-location-mobile" class="inline-block type-label text-brand_accent mb-1">Локация</span>
                    <h3 id="modal-title-mobile" class="type-h3 text-white">Название</h3>
                </div>
            </div>

            <div class="w-full md:w-1/2 p-5 md:p-8 flex flex-col md:overflow-y-auto bg-brand_bg">
                <div class="hidden md:block mb-5 pr-10">
                    <p id="modal-location" class="type-label text-brand_accent mb-2 flex items-center gap-1.5">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                        <span>Локация</span>
                    </p>
                    <h3 id="modal-title-desktop" class="type-h2 text-brand_dark">Название</h3>
                </div>

                <div id="modal-details-badge" class="hidden mb-4 p-3 bg-white border border-brand_dark/10 rounded-lg type-small font-medium text-brand_dark/80"></div>

                <div class="type-small text-brand_dark/85 leading-relaxed mb-6 whitespace-pre-wrap flex-1" id="modal-desc">
                    Описание...
                </div>

                <div class="border-t border-brand_dark/10 pt-4 mt-auto">
                    <div class="flex items-baseline justify-between mb-3">
                        <span class="type-label text-brand_dark/50">Стоимость</span>
                        <span id="modal-price" class="type-h3 text-brand_dark tabular">Цена</span>
                    </div>

                    <form id="modal-form" class="flex flex-col gap-2.5">
                        <input type="hidden" id="modal-tour-name">
                        <input type="text" id="modal-contact" placeholder="Телефон или @telegram" required="" class="w-full bg-white border border-brand_dark/20 rounded-lg px-4 py-3 outline-none focus:border-brand_dark transition-colors">
                        <button type="submit" class="w-full bg-brand_dark text-brand_bg font-bold py-3.5 rounded-lg hover:bg-brand_accent transition-colors shadow-md type-small">
                            Хочу сюда
                        </button>
                        <p class="text-[11px] text-brand_dark/55 text-center">
                            Нажимая кнопку, вы соглашаетесь с <button type="button" onclick="openPrivacy()" class="underline hover:text-brand_dark">политикой конфиденциальности</button>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Политика конфиденциальности (152-ФЗ) -->
    <div id="privacy-modal" class="fixed inset-0 z-[1100] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-brand_dark/80 backdrop-blur-sm" onclick="closePrivacy()"></div>
        <div class="relative bg-white text-brand_dark max-w-2xl w-full max-h-[85vh] overflow-y-auto rounded-xl p-6 md:p-8 shadow-2xl z-10">
            <div class="flex items-center justify-between gap-4 mb-5 pb-4 border-b border-brand_dark/10">
                <h3 class="type-h3">Политика конфиденциальности</h3>
                <button type="button" onclick="closePrivacy()" aria-label="Закрыть" class="w-9 h-9 rounded-full bg-brand_dark/10 text-brand_dark hover:bg-brand_dark hover:text-white flex items-center justify-center transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div class="space-y-3 type-small text-brand_dark/80 leading-relaxed">
                <p>Настоящая Политика конфиденциальности действует в отношении всей информации, которую туристическое агентство <strong>Withiv</strong> может получить о пользователе во время использования сайта.</p>
                <p><strong>1. Какие данные собираются:</strong> имя, номер телефона, никнейм в Telegram и пожелания по подбору тура, которые пользователь добровольно указывает в формах обратной связи.</p>
                <p><strong>2. Цель обработки:</strong> связь с пользователем для расчёта стоимости, подбора и бронирования туристических услуг в соответствии с Федеральным законом № 152-ФЗ «О персональных данных».</p>
                <p><strong>3. Защита и передача данных:</strong> персональные данные не передаются третьим лицам, за исключением случаев, прямо необходимых для бронирования выбранного пользователем тура, либо предусмотренных законодательством РФ.</p>
                <p><strong>4. Отзыв согласия:</strong> пользователь вправе в любой момент запросить удаление своих данных, обратившись по телефону <a href="tel:+79127415413" class="underline font-semibold">+7 (912) 741-54-13</a> или в Telegram-чат менеджера.</p>
            </div>
        </div>
    </div>

    <!-- Продвинутый Интерактивный Квиз -->
    <section id="quiz-section" class="py-14 md:py-24 bg-brand_dark text-brand_bg w-full">
        <div class="max-w-4xl mx-auto px-4 md:px-8">
            <div class="text-center mb-8 md:mb-12">
                <span class="type-label text-brand_accent block mb-2">Глубокий подбор</span>
                <h2 class="type-h2 mb-3">Конструктор путешествия</h2>
                <p class="text-brand_bg/75 type-small max-w-xl mx-auto">Расскажите подробно о своих предпочтениях, чтобы менеджер подготовил максимально точные варианты</p>
            </div>

            <div class="bg-white text-brand_dark rounded-xl p-5 sm:p-6 md:p-10 shadow-2xl relative min-h-[420px] flex flex-col">
                <div class="absolute top-0 left-0 w-full h-1.5 bg-gray-100 rounded-t-xl overflow-hidden">
                    <div id="quiz-progress" class="h-full bg-brand_accent transition-all duration-300 w-[16%]"></div>
                </div>

                <form id="quiz-form" class="flex-1 flex flex-col">

                    <!-- Шаг 1 -->
                    <div class="quiz-step active flex-1" id="step-1">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Шаг 1 из 6</span>
                            <h3 class="type-h3 mb-5">Какой формат отдыха вам ближе?</h3>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-format" value="Пляж и релакс" class="quiz-radio sr-only" checked="">
                                    <div class="border border-brand_dark/20 rounded-lg p-4 hover:border-brand_dark transition-colors flex items-start gap-3">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand_dark/30 mt-0.5 flex items-center justify-center shrink-0 radio-inner">
                                            <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
                                        </div>
                                        <div>
                                            <p class="font-bold type-small">Пляж и полный релакс</p>
                                            <p class="text-xs text-brand_dark/60 mt-1">Отель хорошего уровня, море, солнце, минимум передвижений.</p>
                                        </div>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-format" value="Активный / Экскурсии" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-4 hover:border-brand_dark transition-colors flex items-start gap-3">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand_dark/30 mt-0.5 flex items-center justify-center shrink-0 radio-inner">
                                            <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
                                        </div>
                                        <div>
                                            <p class="font-bold type-small">Активный и экскурсионный</p>
                                            <p class="text-xs text-brand_dark/60 mt-1">Изучение новых мест, поездки, насыщенная программа.</p>
                                        </div>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-format" value="Баланс (Пляж + Город)" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-4 hover:border-brand_dark transition-colors flex items-start gap-3">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand_dark/30 mt-0.5 flex items-center justify-center shrink-0 radio-inner">
                                            <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
                                        </div>
                                        <div>
                                            <p class="font-bold type-small">Баланс (Пляж + Город)</p>
                                            <p class="text-xs text-brand_dark/60 mt-1">Пару дней экскурсий или шоппинга, остальное время на пляже.</p>
                                        </div>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-format" value="Романтика / Уединение" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-4 hover:border-brand_dark transition-colors flex items-start gap-3">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand_dark/30 mt-0.5 flex items-center justify-center shrink-0 radio-inner">
                                            <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
                                        </div>
                                        <div>
                                            <p class="font-bold type-small">Романтика и уединение</p>
                                            <p class="text-xs text-brand_dark/60 mt-1">Медовый месяц или спокойный отдых вдали от шума.</p>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                        <div class="mt-6 flex justify-end">
                            <button type="button" onclick="nextStep(2)" class="bg-brand_dark text-white w-full sm:w-auto px-8 py-3.5 font-bold rounded-lg hover:bg-brand_accent transition-colors type-small">Следующий шаг</button>
                        </div>
                    </div>

                    <!-- Шаг 2 -->
                    <div class="quiz-step flex-1" id="step-2">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Шаг 2 из 6</span>
                            <h3 class="type-h3 mb-5">Куда бы вы хотели отправиться?</h3>

                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-4">
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="Турция" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Турция</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="ОАЭ" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">ОАЭ</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="Египет" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Египет</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="Таиланд" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Таиланд</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="Мальдивы / Сейшелы" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Мальдивы / Сейшелы</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-dest" value="Пока не знаю" class="quiz-radio sr-only" checked="">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Нужен совет</span>
                                    </div>
                                </label>
                            </div>
                            <input type="text" id="custom-dest" placeholder="Или напишите свой вариант (страна, город, отель)..." class="w-full border border-brand_dark/20 px-4 py-3.5 rounded-lg outline-none focus:border-brand_dark bg-white">
                        </div>
                        <div class="mt-6 flex gap-3">
                            <button type="button" onclick="nextStep(1)" class="w-1/3 sm:w-auto bg-gray-100 text-brand_dark hover:bg-gray-200 font-bold px-5 py-3.5 rounded-lg transition-colors type-small">Назад</button>
                            <button type="button" onclick="nextStep(3)" class="flex-1 sm:flex-none bg-brand_dark text-white px-8 py-3.5 font-bold rounded-lg hover:bg-brand_accent transition-colors type-small">Далее</button>
                        </div>
                    </div>

                    <!-- Шаг 3 -->
                    <div class="quiz-step flex-1" id="step-3">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Шаг 3 из 6</span>
                            <h3 class="type-h3 mb-5">Даты поездки и состав отдыхающих</h3>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mb-3.5">
                                <div>
                                    <label class="block type-label text-brand_dark/60 mb-1.5">Взрослых</label>
                                    <select id="quiz-adults" class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white">
                                        <option value="1 взрослый">1 взрослый</option>
                                        <option value="2 взрослых" selected="">2 взрослых</option>
                                        <option value="3 взрослых">3 взрослых</option>
                                        <option value="4 взрослых">4 взрослых</option>
                                        <option value="5+ взрослых">5+ взрослых</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block type-label text-brand_dark/60 mb-1.5">Детей</label>
                                    <select id="quiz-children" class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white" onchange="toggleAges()">
                                        <option value="Без детей" selected="">Без детей</option>
                                        <option value="1 ребенок">1 ребенок</option>
                                        <option value="2 ребенка">2 ребенка</option>
                                        <option value="3+ детей">3+ детей</option>
                                    </select>
                                </div>
                            </div>

                            <div id="children-ages-div" class="hidden mb-3.5">
                                <label class="block type-label text-brand_dark/60 mb-1.5">Возраст детей</label>
                                <input type="text" id="quiz-children-ages" placeholder="Например: 4 года и 10 лет" class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white">
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
                                <div>
                                    <label class="block type-label text-brand_dark/60 mb-1.5">Примерные даты вылета</label>
                                    <input type="text" id="quiz-dates" placeholder="Напр: с 15 по 20 августа" class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white">
                                </div>
                                <div>
                                    <label class="block type-label text-brand_dark/60 mb-1.5">На сколько ночей?</label>
                                    <input type="text" id="quiz-nights" placeholder="Напр: 7-10 ночей" class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white">
                                </div>
                            </div>
                        </div>
                        <div class="mt-6 flex gap-3">
                            <button type="button" onclick="nextStep(2)" class="w-1/3 sm:w-auto bg-gray-100 text-brand_dark hover:bg-gray-200 font-bold px-5 py-3.5 rounded-lg transition-colors type-small">Назад</button>
                            <button type="button" onclick="nextStep(4)" class="flex-1 sm:flex-none bg-brand_dark text-white px-8 py-3.5 font-bold rounded-lg hover:bg-brand_accent transition-colors type-small">Далее</button>
                        </div>
                    </div>

                    <!-- Шаг 4 -->
                    <div class="quiz-step flex-1" id="step-4">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Шаг 4 из 6</span>
                            <h3 class="type-h3 mb-5">Уровень отеля и питание</h3>

                            <label class="block type-label text-brand_dark/60 mb-2">Категория отеля</label>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-hotel" value="Любые варианты" class="quiz-radio sr-only" checked="">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Неважно</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-hotel" value="Хорошие 4*" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Хорошие 4*</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-hotel" value="Стандартные 5*" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small">Бюджетные 5*</span>
                                    </div>
                                </label>
                                <label class="cursor-pointer relative">
                                    <input type="radio" name="quiz-hotel" value="Премиум 5* / Люкс" class="quiz-radio sr-only">
                                    <div class="border border-brand_dark/20 rounded-lg p-3 text-center hover:border-brand_dark transition-colors">
                                        <span class="font-semibold type-small text-brand_accent">Премиум 5*</span>
                                    </div>
                                </label>
                            </div>

                            <label class="block type-label text-brand_dark/60 mb-2">Предпочтения по питанию</label>
                            <select id="quiz-food" class="w-full border border-brand_dark/20 px-4 py-3.5 rounded-lg outline-none focus:border-brand_dark bg-white">
                                <option value="Всё включено (AI/UAI)">Всё включено / Ультра всё включено</option>
                                <option value="Завтрак + Ужин (HB)">Завтрак + Ужин</option>
                                <option value="Только завтраки (BB)">Только завтраки</option>
                                <option value="Без питания (RO)">Без питания (апартаменты)</option>
                                <option value="Зависит от страны" selected="">Зависит от страны (посоветуйте)</option>
                            </select>
                        </div>
                        <div class="mt-6 flex gap-3">
                            <button type="button" onclick="nextStep(3)" class="w-1/3 sm:w-auto bg-gray-100 text-brand_dark hover:bg-gray-200 font-bold px-5 py-3.5 rounded-lg transition-colors type-small">Назад</button>
                            <button type="button" onclick="nextStep(5)" class="flex-1 sm:flex-none bg-brand_dark text-white px-8 py-3.5 font-bold rounded-lg hover:bg-brand_accent transition-colors type-small">Далее</button>
                        </div>
                    </div>

                    <!-- Шаг 5 -->
                    <div class="quiz-step flex-1" id="step-5">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Шаг 5 из 6</span>
                            <h3 class="type-h3 mb-5">Бюджет и особые пожелания</h3>

                            <label class="block type-label text-brand_dark/60 mb-2">Ориентировочный бюджет (на всех)</label>
                            <input type="text" id="quiz-budget" placeholder="Например: до 400 000 руб." class="w-full border border-brand_dark/20 px-4 py-3.5 rounded-lg outline-none focus:border-brand_dark bg-white mb-4">

                            <label class="block type-label text-brand_dark/60 mb-2">Важные детали (по желанию)</label>
                            <textarea id="quiz-notes" rows="3" placeholder="Первая линия, пологий вход в море, тихое место, нужен дайвинг..." class="w-full border border-brand_dark/20 px-4 py-3 rounded-lg outline-none focus:border-brand_dark bg-white resize-none"></textarea>
                        </div>
                        <div class="mt-6 flex gap-3">
                            <button type="button" onclick="nextStep(4)" class="w-1/3 sm:w-auto bg-gray-100 text-brand_dark hover:bg-gray-200 font-bold px-5 py-3.5 rounded-lg transition-colors type-small">Назад</button>
                            <button type="button" onclick="nextStep(6)" class="flex-1 sm:flex-none bg-brand_dark text-white px-8 py-3.5 font-bold rounded-lg hover:bg-brand_accent transition-colors type-small">Финальный шаг</button>
                        </div>
                    </div>

                    <!-- Шаг 6 -->
                    <div class="quiz-step flex-1" id="step-6">
                        <div class="mb-auto">
                            <span class="type-label text-brand_dark/50 mb-2 block">Финал</span>
                            <h3 class="type-h3 mb-2">Куда отправить подборку туров?</h3>
                            <p class="type-small text-brand_dark/70 mb-5">Менеджер изучит заявку и пришлет 3–5 проверенных вариантов с расчетом цены.</p>

                            <div>
                                <label class="block type-label text-brand_dark/60 mb-1.5">Как к вам обращаться?</label>
                                <input type="text" id="quiz-name" placeholder="Ваше имя" required="" class="w-full border border-brand_dark/20 px-4 py-3.5 rounded-lg outline-none focus:border-brand_dark bg-white mb-3.5">
                            </div>

                            <div>
                                <label class="block type-label text-brand_dark/60 mb-1.5">Номер телефона или Telegram</label>
                                <input type="text" id="quiz-contact" placeholder="+7 (999) 000-00-00 или @username" required="" class="w-full border border-brand_dark/25 px-4 py-3.5 rounded-lg outline-none focus:border-brand_dark bg-white">
                            </div>
                        </div>
                        <div class="mt-6">
                            <div class="flex flex-col sm:flex-row gap-3 items-center">
                                <button type="button" onclick="nextStep(5)" class="w-full sm:w-auto bg-gray-100 text-brand_dark hover:bg-gray-200 font-bold px-6 py-4 rounded-lg transition-colors order-2 sm:order-1 type-small">Назад</button>
                                <button type="submit" id="quiz-submit-btn" class="w-full sm:flex-1 bg-brand_accent text-white px-8 py-4 font-bold rounded-lg hover:bg-brand_dark transition-colors shadow-lg order-1 sm:order-2 type-small">Получить расчет стоимости</button>
                            </div>
                            <p class="text-[11px] text-brand_dark/55 text-center mt-3">
                                Нажимая кнопку, вы соглашаетесь с <button type="button" onclick="openPrivacy()" class="underline hover:text-brand_dark">политикой конфиденциальности</button>
                            </p>
                        </div>
                    </div>

                    <!-- Успех -->
                    <div class="quiz-step text-center py-8 md:py-12 flex-1 flex-col justify-center" id="step-success">
                        <svg class="w-16 h-16 text-green-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <h3 class="type-h2 mb-2">Заявка принята в работу</h3>
                        <p class="type-small text-brand_dark/70 max-w-md mx-auto">Спасибо за подробные ответы! Менеджер агентства свяжется с вами в ближайшее время.</p>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Agency Profile -->
    <section id="about" class="py-14 md:py-24 bg-brand_bg border-t border-brand_dark/10 w-full">
        <div class="max-w-7xl mx-auto px-4 md:px-8">
            <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
                <div class="w-full md:w-3/5 text-center md:text-left">
                    <span class="type-label text-brand_accent block mb-2">Философия отдыха</span>
                    <h2 class="type-h2 mb-5">Об агентстве Withiv</h2>

                    <div class="space-y-4 text-brand_dark/80 leading-relaxed text-left">
                        <p>Withiv — современное, динамично развивающееся туристическое агентство. Мы создаем путешествия, в которых продумана каждая деталь: от выбора пляжа и концепции отеля до удобных стыковок и индивидуальных трансферов.</p>
                        <p>Мы не предлагаем шаблонные варианты «для галочки». Наша команда лично проверяет отельную базу, следит за актуальными правилами въезда и остается на связи 24/7 с момента бронирования до вашего возвращения домой.</p>
                    </div>

                    <div class="mt-8 flex flex-col sm:flex-row justify-center md:justify-start gap-3">
                        <a href="https://t.me/withivtravel13" target="_blank" rel="noopener noreferrer" class="bg-brand_dark text-white px-7 py-3.5 rounded-lg font-bold hover:bg-brand_accent transition-colors type-small text-center">Наш Telegram-канал</a>
                        <a href="https://wa.me/79127415413" target="_blank" rel="noopener noreferrer" class="border border-[#25D366] text-[#25D366] bg-white px-7 py-3.5 rounded-lg font-bold hover:bg-[#25D366] hover:text-white transition-colors type-small text-center flex justify-center items-center gap-2">WhatsApp</a>
                    </div>
                </div>

                <div class="w-full md:w-2/5 flex flex-row justify-center md:justify-end gap-3 sm:gap-4">
                    <div class="text-center p-4 border border-brand_dark/10 rounded-xl bg-white w-36 sm:w-44 shrink-0 shadow-sm">
                        <img src="./qr-manager_files/saved_resource(1)" alt="QR Менеджер" class="w-24 h-24 sm:w-28 sm:h-28 mb-2.5 mx-auto" loading="lazy">
                        <p class="type-label text-brand_dark">Написать в чат</p>
                    </div>
                    <div class="text-center p-4 border border-brand_dark/10 rounded-xl bg-white w-36 sm:w-44 shrink-0 shadow-sm">
                        <img src="./qr-manager_files/saved_resource(2)" alt="QR Канал" class="w-24 h-24 sm:w-28 sm:h-28 mb-2.5 mx-auto" loading="lazy">
                        <p class="type-label text-brand_dark">Горящие туры</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-brand_dark text-brand_bg mt-auto border-t border-white/10 w-full">
        <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

                <div class="md:col-span-5 text-center md:text-left flex flex-col items-center md:items-start">
                    <a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#" class="mb-4 block transition-opacity duration-300 hover:opacity-85">
                        <img src="./qr-manager_files/logo.jpg" alt="Withiv Турагентство" class="h-16 md:h-20 w-auto object-contain logo-dark-bg">
                    </a>
                    <p class="type-small text-brand_bg/70 max-w-sm">Индивидуальный подбор туров, бронирование отелей и полное сопровождение в поездке.</p>
                </div>

                <div class="md:col-span-3 text-center md:text-left">
                    <h4 class="type-label text-white mb-4">Разделы</h4>
                    <ul class="space-y-2.5 type-small text-brand_bg/75">
                        <li><a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tourvisor-search" class="hover:text-brand_accent transition-colors">Поиск туров</a></li>
                        <li><a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#tours" class="hover:text-brand_accent transition-colors">Авторские туры</a></li>
                        <li><a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#quiz-section" class="hover:text-brand_accent transition-colors">Подобрать тур</a></li>
                        <li><a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#reviews" class="hover:text-brand_accent transition-colors">Отзывы туристов</a></li>
                        <li><a href="https://makarchik010.github.io/withiv-agency/frontend/index.html#about" class="hover:text-brand_accent transition-colors">Об агентстве</a></li>
                    </ul>
                </div>

                <div class="md:col-span-4 text-center md:text-left">
                    <h4 class="type-label text-white mb-4">Контакты</h4>
                    <ul class="space-y-2.5 type-small text-brand_bg/75">
                        <li><a href="tel:+79127415413" class="type-h3 text-white hover:text-brand_accent transition-colors tabular">+7 (912) 741-54-13</a></li>
                        <li><a href="https://wa.me/79127415413" target="_blank" rel="noopener noreferrer" class="hover:text-brand_accent transition-colors">Написать в WhatsApp</a></li>
                        <li><a href="https://t.me/withivtravel13" target="_blank" rel="noopener noreferrer" class="hover:text-brand_accent transition-colors">Telegram-канал Withiv</a></li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-white/10 mt-10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-brand_bg/60">
                <p>© 2026 Withiv. Все права защищены</p>
                <button type="button" onclick="openPrivacy()" class="hover:text-white transition-colors underline underline-offset-4">Политика конфиденциальности</button>
            </div>
        </div>
    </footer>

    <script>
        const GAS_API_URL = 'https://script.google.com/macros/s/AKfycbyfm98Wbr_Mwar3n8924oXOSQ1ZwVMg2jB_Ik1d_kULMANbzj332Odu2D9R6w0b4ts/exec';
        const FALLBACK_IMAGE = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=800&auto=format&fit=crop';
        let globalTours = [];
        let currentQuizStep = 1;

        function optimizeCloudinaryUrl(url, width = 800) {
            if (!url || !String(url).startsWith('http')) return FALLBACK_IMAGE;
            if (url.includes('res.cloudinary.com') && url.includes('/upload/') && !url.includes('f_auto')) {
                return url.replace('/upload/', `/upload/f_auto,q_auto,w_${width}/`);
            }
            return url;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const utmData = {
            source: urlParams.get('utm_source') || 'Органика',
            medium: urlParams.get('utm_medium') || 'Неизвестно',
            campaign: urlParams.get('utm_campaign') || 'Без кампании'
        };

        try {
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIcon = document.getElementById('menu-icon');
            const closeIcon = document.getElementById('close-icon');

            function toggleMenu() {
                const isHidden = mobileMenu.classList.contains('hidden');
                mobileMenu.classList.toggle('hidden', !isHidden);
                mobileMenu.classList.toggle('flex', isHidden);
                menuIcon.classList.toggle('hidden', isHidden);
                closeIcon.classList.toggle('hidden', !isHidden);
                document.body.style.overflow = isHidden ? 'hidden' : '';
            }

            if (mobileBtn) {
                mobileBtn.addEventListener('click', toggleMenu);
                document.querySelectorAll('.mobile-link').forEach(link => {
                    link.addEventListener('click', () => {
                        if (!mobileMenu.classList.contains('hidden')) toggleMenu();
                    });
                });
            }
        } catch (e) {}

        window.scrollReviews = function(offset) {
            const container = document.getElementById('reviews-container');
            if (container) container.scrollBy({ left: offset, behavior: 'smooth' });
        };

        window.openPrivacy = function() {
            const el = document.getElementById('privacy-modal');
            if (!el) return;
            el.classList.remove('hidden');
            el.classList.add('flex');
            document.body.style.overflow = 'hidden';
        };

        window.closePrivacy = function() {
            const el = document.getElementById('privacy-modal');
            if (!el) return;
            el.classList.add('hidden');
            el.classList.remove('flex');
            const tourModal = document.getElementById('tour-modal');
            if (!tourModal || tourModal.classList.contains('hidden')) {
                document.body.style.overflow = '';
            }
        };

        window.toggleAges = function() {
            try {
                const childrenSelect = document.getElementById('quiz-children');
                const agesDiv = document.getElementById('children-ages-div');
                if (childrenSelect && agesDiv) {
                    agesDiv.classList.toggle('hidden', childrenSelect.value === 'Без детей');
                }
            } catch (e) {}
        };

        async function fetchWithRetry(url, maxRetries = 3, delay = 3000) {
            for (let i = 0; i < maxRetries; i++) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 12000);

                    const cacheBusterUrl = new URL(url);
                    cacheBusterUrl.searchParams.append('_t', new Date().getTime());

                    const response = await fetch(cacheBusterUrl.toString(), {
                        signal: controller.signal
                    });
                    clearTimeout(timeoutId);

                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    return await response.json();
                } catch (e) {
                    if (i === maxRetries - 1) throw e;
                    const loadingText = document.getElementById('loading-text');
                    if (loadingText) {
                        loadingText.innerText = `Подключение к базе туров (${i + 1}/${maxRetries})...`;
                    }
                    await new Promise(resolve => setTimeout(resolve, delay));
                }
            }
        }

        function renderFilters(tours) {
            try {
                const tabsContainer = document.getElementById('filter-tabs');
                if (!tabsContainer) return;

                if (!Array.isArray(tours) || tours.length === 0) {
                    tabsContainer.innerHTML = '';
                    return;
                }

                const locationsRaw = tours
                    .filter(t => t && typeof t === 'object' && t['Локация'])
                    .map(t => String(t['Локация']).split(',')[0].trim())
                    .filter(Boolean);

                const uniqueLocations = [...new Set(locationsRaw)];

                let html = `<button data-filter="all" class="filter-btn px-4 py-2 bg-brand_dark text-brand_bg type-small font-semibold rounded-full whitespace-nowrap transition-colors">Все направления</button>`;
                uniqueLocations.forEach(loc => {
                    html += `<button data-filter="${loc}" class="filter-btn px-4 py-2 border border-brand_dark/20 text-brand_dark type-small font-semibold rounded-full hover:border-brand_dark transition-colors whitespace-nowrap">${loc}</button>`;
                });
                tabsContainer.innerHTML = html;

                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        document.querySelectorAll('.filter-btn').forEach(b => {
                            b.classList.remove('bg-brand_dark', 'text-brand_bg');
                            b.classList.add('border', 'border-brand_dark/20', 'text-brand_dark');
                        });
                        e.target.classList.add('bg-brand_dark', 'text-brand_bg');
                        e.target.classList.remove('border', 'border-brand_dark/20', 'text-brand_dark');

                        const filter = e.target.dataset.filter;
                        if (filter === 'all') {
                            renderTours(globalTours);
                        } else {
                            const filtered = globalTours.filter(t => t && String(t['Локация'] || '').includes(filter));
                            renderTours(filtered);
                        }
                    });
                });
            } catch (e) {}
        }

        function renderTours(list) {
            const grid = document.getElementById('tours-grid');
            if (!grid) return;

            if (!Array.isArray(list) || list.length === 0) {
                grid.innerHTML = '<div class="col-span-full py-12 text-center font-medium text-brand_dark/60 type-small">В данный момент по этому направлению нет предложений в коллекции.</div>';
                return;
            }

            try {
                grid.innerHTML = list.map((tour) => {
                    if (!tour || typeof tour !== 'object') return '';

                    const realIdx = globalTours.indexOf(tour);
                    const title = tour['Название'] ? String(tour['Название']).replace(/</g, "&lt;") : 'Тур под запрос';
                    const location = tour['Локация'] ? String(tour['Локация']).replace(/</g, "&lt;") : 'Секретное место';
                    const price = tour['Цена'] ? String(tour['Цена']).replace(/</g, "&lt;") : 'По запросу';
                    const details = tour['Детали'] ? String(tour['Детали']).replace(/</g, "&lt;") : '';
                    const imgUrl = optimizeCloudinaryUrl(tour['Фото'], 800);

                    return `
                        <article onclick="openModal(${realIdx})" class="cursor-pointer group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 border border-brand_dark/10 overflow-hidden flex flex-col">
                            <div class="h-52 md:h-64 overflow-hidden relative bg-brand_dark">
                                <img src="${imgUrl}" onerror="this.onerror=null;this.src='${FALLBACK_IMAGE}';" alt="${title}" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
                                <div class="absolute bottom-3 left-3 bg-brand_dark/90 backdrop-blur-sm text-white px-3 py-1 type-label !tracking-wider rounded-full shadow-md">${location}</div>
                            </div>
                            <div class="p-5 flex-1 flex flex-col justify-between bg-white">
                                <div>
                                    <h3 class="type-h3 mb-2 group-hover:text-brand_accent transition-colors line-clamp-2">${title}</h3>
                                    ${details ? `<p class="type-small text-brand_dark/60 mb-4 line-clamp-1">${details}</p>` : ''}
                                </div>
                                <div class="flex justify-between items-center border-t border-brand_dark/10 pt-4 mt-auto">
                                    <span class="font-bold text-brand_dark tabular">${price}</span>
                                    <span class="type-small font-bold text-brand_accent flex items-center gap-1">Подробнее <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                                </div>
                            </div>
                        </article>
                    `;
                }).join('');
            } catch (e) {
                grid.innerHTML = '<div class="col-span-full py-12 text-center text-red-600 type-small">Произошла ошибка при отображении коллекции туров.</div>';
            }
        }

        function renderReviewsHtml(reviews) {
            const container = document.getElementById('reviews-container');
            if (!container) return;

            if (!Array.isArray(reviews) || reviews.length === 0) {
                container.innerHTML = '<div class="w-full text-center py-12 text-brand_dark/50 type-small">Отзывы скоро появятся...</div>';
                return;
            }

            container.innerHTML = reviews.map(r => {
                const text = String(r['Текст'] || r['Отзыв'] || r.text || '').replace(/</g, "&lt;");
                const name = String(r['Имя'] || r.name || 'Гость').replace(/</g, "&lt;");
                const loc = String(r['Локация'] || r['Куда летали'] || r.location || '').replace(/</g, "&lt;");
                return `
                <div class="w-80 md:w-96 shrink-0 bg-white border border-brand_dark/10 p-6 md:p-8 rounded-xl snap-center shadow-sm flex flex-col">
                    <div class="flex items-center gap-1 mb-4 text-brand_accent">
                        ${'<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'.repeat(5)}
                    </div>
                    <p class="text-brand_dark/80 type-small leading-relaxed mb-6 italic flex-1">«${text}»</p>
                    <div class="mt-auto border-t border-brand_dark/10 pt-4">
                        <p class="font-bold type-small text-brand_dark">${name}</p>
                        ${loc ? `<p class="type-label text-brand_dark/50 mt-1">${loc}</p>` : ''}
                    </div>
                </div>`;
            }).join('');
        }

        async function loadTours() {
            const grid = document.getElementById('tours-grid');
            if (!grid) return;

            const cached = localStorage.getItem('withiv_cache_tours');
            if (cached) {
                try {
                    globalTours = JSON.parse(cached);
                    renderFilters(globalTours);
                    renderTours(globalTours);
                } catch (e) {}
            }

            try {
                const data = await fetchWithRetry(`${GAS_API_URL}?action=tours&site=1`);
                const fresh = Array.isArray(data) ? data : [];
                const freshStr = JSON.stringify(fresh);
                if (freshStr !== cached) {
                    localStorage.setItem('withiv_cache_tours', freshStr);
                    globalTours = fresh;
                    renderFilters(globalTours);
                    renderTours(globalTours);
                }
            } catch (err) {
                if (!cached) {
                    grid.innerHTML = '<div class="col-span-full py-12 text-center font-medium text-brand_dark/60 bg-white border border-brand_dark/10 rounded-xl p-6 type-small">Временно не удалось загрузить авторскую коллекцию туров.</div>';
                }
            }
        }

        async function loadReviews() {
            const container = document.getElementById('reviews-container');
            if (!container) return;

            const cached = localStorage.getItem('withiv_cache_reviews');
            if (cached) {
                try { renderReviewsHtml(JSON.parse(cached)); } catch (e) {}
            }

            try {
                const reviews = await fetchWithRetry(`${GAS_API_URL}?action=reviews`, 2, 2000);
                const fresh = Array.isArray(reviews) ? reviews : [];
                const freshStr = JSON.stringify(fresh);
                if (freshStr !== cached) {
                    localStorage.setItem('withiv_cache_reviews', freshStr);
                    renderReviewsHtml(fresh);
                }
            } catch (err) {
                if (!cached) {
                    container.innerHTML = '<div class="w-full text-center py-10 text-brand_dark/50 type-small">Временно не удалось загрузить отзывы</div>';
                }
            }
        }

        const modal = document.getElementById('tour-modal');
        const modalBackdrop = document.getElementById('modal-backdrop');

        window.openModal = function(idx) {
            try {
                const t = globalTours[idx];
                if (!t || !modal || !modalBackdrop) return;

                const imgEl = document.getElementById('modal-img');
                imgEl.src = optimizeCloudinaryUrl(t['Фото'], 1200);
                imgEl.onerror = function() { this.onerror=null; this.src=FALLBACK_IMAGE; };

                document.getElementById('modal-title-desktop').innerText = t['Название'] || 'Тур';
                document.getElementById('modal-title-mobile').innerText = t['Название'] || 'Тур';
                document.getElementById('modal-location').querySelector('span').innerText = t['Локация'] || '';
                document.getElementById('modal-location-mobile').innerText = t['Локация'] || '';

                const detailsBadge = document.getElementById('modal-details-badge');
                const descEl = document.getElementById('modal-desc');

                // Безопасная вставка текста (защита от XSS)
                if (t['Описание'] && t['Детали']) {
                    detailsBadge.innerText = t['Детали'];
                    detailsBadge.classList.remove('hidden');
                    descEl.innerText = String(t['Описание']);
                } else {
                    detailsBadge.classList.add('hidden');
                    descEl.innerText = String(t['Описание'] || t['Детали'] || 'Подробную программу тура уточняйте у менеджера');
                }

                document.getElementById('modal-price').innerText = t['Цена'] || 'По запросу';
                document.getElementById('modal-tour-name').value = t['Название'] || 'Без названия';

                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';

                requestAnimationFrame(() => {
                    modalBackdrop.classList.remove('opacity-0');
                    modal.classList.remove('modal-closed');
                    modal.classList.add('modal-open');
                });
            } catch (e) {}
        };

        window.closeModal = function() {
            if (!modal || !modalBackdrop) return;
            modalBackdrop.classList.add('opacity-0');
            modal.classList.remove('modal-open');
            modal.classList.add('modal-closed');

            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            }, 350);
        };

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const privacyEl = document.getElementById('privacy-modal');
                if (privacyEl && !privacyEl.classList.contains('hidden')) {
                    window.closePrivacy();
                } else if (modal && !modal.classList.contains('hidden')) {
                    window.closeModal();
                }
            }
        });

        const modalForm = document.getElementById('modal-form');
        if (modalForm) {
            modalForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = e.target.querySelector('button[type="submit"]');
                if (!btn || btn.disabled) return;

                const origText = btn.innerText;
                btn.innerText = 'Отправка...';
                btn.disabled = true;

                try {
                    const response = await fetch(GAS_API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify({
                            action: 'lead',
                            name: 'Запрос по туру: ' + document.getElementById('modal-tour-name').value,
                            contact: document.getElementById('modal-contact').value,
                            comment: `Цена: ${document.getElementById('modal-price').innerText}\nUTM: ${utmData.source} | ${utmData.medium} | ${utmData.campaign}`
                        })
                    });

                    const resData = await response.json();
                    if (!resData.ok) throw new Error("Server rejected lead");

                    btn.innerText = 'Успешно отправлено!';
                    btn.classList.replace('bg-brand_dark', 'bg-green-600');
                    setTimeout(window.closeModal, 1500);
                } catch(err) {
                    btn.innerText = 'Ошибка. Попробуйте позже';
                    btn.classList.replace('bg-brand_dark', 'bg-red-600');
                } finally {
                    setTimeout(() => {
                        btn.innerText = origText;
                        btn.classList.remove('bg-green-600', 'bg-red-600');
                        btn.classList.add('bg-brand_dark');
                        btn.disabled = false;
                        e.target.reset();
                    }, 3000);
                }
            });
        }

        window.nextStep = function(step) {
            try {
                currentQuizStep = step;
                document.querySelectorAll('.quiz-step').forEach(el => el.classList.remove('active'));
                const nextStepEl = document.getElementById(`step-${step}`);
                if (nextStepEl) {
                    nextStepEl.classList.add('active');
                    const progressEl = document.getElementById('quiz-progress');
                    if (progressEl) progressEl.style.width = `${(step / 6) * 100}%`;

                    const quizSection = document.getElementById('quiz-section');
                    if (quizSection && quizSection.getBoundingClientRect().top < 0) {
                        quizSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            } catch (e) {}
        };

        const quizForm = document.getElementById('quiz-form');
        if (quizForm) {
            // Защита от сломанного Enter на шагах 1-5
            quizForm.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA' && currentQuizStep < 6) {
                    e.preventDefault();
                    window.nextStep(currentQuizStep + 1);
                }
            });

            quizForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('quiz-submit-btn');
                if (!btn || btn.disabled) return;

                const origText = btn.innerText;
                btn.innerText = 'Отправка заявки...';
                btn.disabled = true;

                try {
                    const formatInput = document.querySelector('input[name="quiz-format"]:checked');
                    const destRadio = document.querySelector('input[name="quiz-dest"]:checked');
                    const customDest = document.getElementById('custom-dest');

                    const format = formatInput ? formatInput.value : 'Не указан';
                    let destination = (customDest && customDest.value.trim())
                        ? customDest.value.trim()
                        : (destRadio ? destRadio.value : 'Не указано');

                    const adults = document.getElementById('quiz-adults') ? document.getElementById('quiz-adults').value : '';
                    const children = document.getElementById('quiz-children') ? document.getElementById('quiz-children').value : '';
                    let kidsAgeText = "";
                    if (children !== 'Без детей') {
                        const agesInput = document.getElementById('quiz-children-ages');
                        kidsAgeText = `(Возраст: ${agesInput && agesInput.value ? agesInput.value : 'не указан'})`;
                    }
                    const comp = `${adults}, ${children} ${kidsAgeText}`.trim();

                    const datesInput = document.getElementById('quiz-dates');
                    const nightsInput = document.getElementById('quiz-nights');
                    const dates = `${datesInput && datesInput.value ? datesInput.value : '-'} на ${nightsInput && nightsInput.value ? nightsInput.value : '-'}`;

                    const hotelInput = document.querySelector('input[name="quiz-hotel"]:checked');
                    const foodInput = document.getElementById('quiz-food');
                    const budgetInput = document.getElementById('quiz-budget');
                    const notesInput = document.getElementById('quiz-notes');

                    const hotel = hotelInput ? hotelInput.value : 'Любой';
                    const food = foodInput ? foodInput.value : 'Любое';
                    const budget = budgetInput && budgetInput.value ? budgetInput.value : 'Не указан';
                    const notes = notesInput && notesInput.value ? notesInput.value : 'Нет';

                    const name = document.getElementById('quiz-name') ? document.getElementById('quiz-name').value : 'Без имени';
                    const contact = document.getElementById('quiz-contact') ? document.getElementById('quiz-contact').value : 'Без контакта';

                    const comment = `[КВИЗ]\nФормат: ${format}\nСтрана: ${destination}\nСостав: ${comp}\nДаты: ${dates}\nОтель: ${hotel} (${food})\nБюджет: ${budget}\nПожелания: ${notes}\nUTM: ${utmData.source} | ${utmData.medium} | ${utmData.campaign}`;

                    const response = await fetch(GAS_API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify({
                            action: 'lead',
                            name: name,
                            contact: contact,
                            comment: comment
                        })
                    });

                    const resData = await response.json();
                    if (!resData.ok) throw new Error("Server rejected quiz lead");

                    document.querySelectorAll('.quiz-step').forEach(el => el.classList.remove('active'));
                    const successStep = document.getElementById('step-success');
                    if (successStep) successStep.classList.add('active');
                    const progressEl = document.getElementById('quiz-progress');
                    if (progressEl) progressEl.style.width = '100%';

                } catch(err) {
                    btn.innerText = 'Ошибка сети. Попробуйте еще раз';
                    btn.classList.add('bg-red-600');
                    setTimeout(() => {
                        btn.innerText = origText;
                        btn.classList.remove('bg-red-600');
                        btn.disabled = false;
                    }, 3000);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            Promise.allSettled([
                loadTours(),
                loadReviews()
            ]);
        });
    </script>


</body></html>